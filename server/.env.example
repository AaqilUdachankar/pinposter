# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or self-hosted)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pinposter?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pinposter?retryWrites=true&w=majority

# Security Secrets (Generate using: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_min_32_characters_long_random_string
ENCRYPTION_KEY=your_aes_256_encryption_key_exactly_64_hex_characters

# Application URLs
CLIENT_URL=https://your-pinposter-frontend.vercel.app
PUBLIC_BASE_URL=https://your-pinposter-backend.onrender.com
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional Cloudinary (for production 1080x1920 image hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional AI API Key (can also be configured from dashboard UI)
GEMINI_API_KEY=your_gemini_api_key
